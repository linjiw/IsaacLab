# Experiment run outputs (journals, per-run logs) — regenerated, not source
_runs/
# Run-local artifacts (manifest is regenerated by holdout.py; review script is a workflow scratch)
_phase1_manifest.json
_easy_manifest.json
_phase1_review.js
# Python caches / bytecode
__pycache__/
*.pyc
.pytest_cache/
# Test venv (built on demand, see runmanager/README.md)
.venv/

# The repo-root .gitignore ignores all `tests/` dirs; but the vendored core's
# test suite IS source (its provenance/regression guarantee) — un-ignore it.
!runmanager/tests/
!runmanager/tests/**
